{
  "name": "uangq",
  "version": "1.3.0",
  "private": true,
  "description": "UangQ - aplikasi keuangan Android & Windows dengan database bersama",
  "main": "electron/main.js",
  "author": "UangQ",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "build:exe": "electron-builder --win nsis --publish never",
    "android:add": "cap add android",
    "android:patch": "node scripts/patch-android.js",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@supabase/supabase-js": "2.45.4",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.uangq.app",
    "productName": "UangQ",
    "files": [
      "electron/**",
      "www/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "UangQ",
        "schemes": [
          "uangq"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
